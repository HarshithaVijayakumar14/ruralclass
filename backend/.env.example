PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Credentials (PostgreSQL / Auth / Realtime)
# SUPABASE_URL: Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_SERVICE_ROLE_KEY: Server-side only key with full admin privileges (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini API
# GEMINI_API_KEY: Secret API key for Google Gemini LLM (obtainable from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL: Model to use for structured lesson planning and assessment (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
